{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Cloudflare Worker",
  // A Worker: no DOM. The runtime globals come from the app's own
  // worker-configuration.d.ts, generated by `wrangler types`, which the app
  // lists in `types` next to any Node compat or test globals it needs.
  // JSX is on because Workers here render React Email templates.
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
