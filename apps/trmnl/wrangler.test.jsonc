{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Test-only config for the Vitest Workers pool: the local bindings the
  // code touches (KV), none of the remote ones (AI is mocked in tests).
  "name": "trmnl-test",
  "main": "index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "TRMNL_CACHE_KV", "id": "test" }]
}
