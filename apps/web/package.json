{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate:content && vite build",
    "check-types": "pnpm run generate:content && tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run generate:content && vite dev --port 3000",
    "e2e": "playwright test",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "pnpm run generate:content && vitest run",
    "test:watch": "vitest",
    "generate:content": "rm -rf .content-collections/cache && content-collections build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@fontsource-variable/lora": "5.2.8",
    "@mdx-js/react": "3.1.1",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "@workspace/emailing": "workspace:*",
    "@workspace/ui": "workspace:*",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "3.21.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@content-collections/cli": "0.1.9",
    "@content-collections/core": "0.15.2",
    "@content-collections/vite": "0.3.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.57.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/mdx": "2.0.13",
    "@types/node": "24.10.4",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@workspace/typescript-config": "workspace:*",
    "jsdom": "27.0.0",
    "satori": "0.26.0",
    "schema-dts": "^2.0.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.4.1"
}
