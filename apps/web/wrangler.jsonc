{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somai-me",
  "main": "@tanstack/react-start/server-entry",
  // Dates from 2026-08-04 enable Node.js compatibility (and process.env
  // populated from secrets) without a flag. Keep it at or before the workerd
  // release bundled by the pinned @cloudflare/vite-plugin.
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // The site's Custom Domain: wrangler creates the DNS record and certificate
  // on deploy (the hostname must have no other DNS record). The apex,
  // somai.me, is not routed here on purpose: static assets are served before
  // the Worker, so a second domain would serve the site twice instead of
  // redirecting. It redirects to www with a zone Redirect Rule (see README).
  "routes": [{ "pattern": "www.somai.me", "custom_domain": true }],
  // Production answers only on the Custom Domain. PR builds upload preview
  // versions (Workers Builds runs `wrangler versions upload` for non-production
  // branches), which never touch routes and keep their workers.dev URLs;
  // preview_urls is explicit because it defaults to the value of workers_dev.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    // Prerendered pages are flat .html files served at their extensionless URL.
    "html_handling": "drop-trailing-slash"
  },
  "upload_source_maps": true,
  // Secrets are not stored here. The newsletter form needs RESEND_API_KEY and
  // RESEND_SEGMENT_GENERAL: locally in .dev.vars (see .dev.vars.example), in
  // production via `wrangler secret put <NAME>` or the Workers dashboard.
  "secrets": {
    "required": ["RESEND_API_KEY", "RESEND_SEGMENT_GENERAL"]
  },
  "env": {
    // Selected with CLOUDFLARE_ENV=e2e; the Playwright suite builds and
    // previews it. The Worker talks to the fake Resend server from
    // tests/e2e/fakes instead of api.resend.com (the SDK reads
    // RESEND_BASE_URL), with the dummy secrets committed in .dev.vars.e2e.
    // It is never deployed.
    "e2e": {
      "vars": {
        "RESEND_BASE_URL": "http://127.0.0.1:4174"
      },
      "secrets": {
        "required": ["RESEND_API_KEY", "RESEND_SEGMENT_GENERAL"]
      },
      // Neither key is inherited by environments; empty routes also guard
      // against a stray `wrangler deploy --env e2e` taking over the domain.
      "routes": []
    }
  }
}
