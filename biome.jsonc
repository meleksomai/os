{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/next"],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/dist",
      "!**/.biome",
      "!**/.next",
      "!**/out",
      // TanStack Start build output + generated route tree
      "!**/.output",
      "!**/.nitro",
      "!**/routeTree.gen.ts",
      // Liquid templates
      "!**/*.liquid.html"
    ]
  },
  "linter": {
    "includes": ["./apps/**", "./packages/**"],
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      },
      "style": {
        "useBlockStatements": "off"
      }
    }
  },
  "overrides": [
    {
      // TanStack Router file-based routes encode URL segments via literal dots
      // and the `[.]` escape (e.g. essay.$slug[.]md.ts, sitemap[.]xml.ts), which
      // the kebab-case filename rule cannot express. The names are mandated by
      // the route generator.
      "includes": ["./apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
