{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react"],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/dist",
      "!**/.biome",
      "!**/.wrangler",
      // Static assets (SVG art, favicons) are not source
      "!**/public",
      "!**/.content-collections",
      // Golden test fixtures must stay byte-exact
      "!**/tests/fixtures",
      "!**/routeTree.gen.ts",
      // Git worktrees live under .claude/worktrees and carry their own root config
      "!**/.claude/worktrees",
      // Liquid templates
      "!**/*.liquid.html"
    ]
  },
  "overrides": [
    {
      // The server modules are the only readers of the generated content collection
      "includes": ["apps/web/src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      // TanStack Router file-based routes use $params, [.] escapes, and {$param} patterns
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "includes": ["./apps/**", "./packages/**"],
    "rules": {
      "performance": {
        "noBarrelFile": "off"
      },
      "style": {
        "useBlockStatements": "off",
        // The generated content collection is server-only; see apps/web/content-collections.ts
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "content-collections": "Server-only content: read it through src/server/<domain>/server.ts"
            }
          }
        }
      }
    }
  }
}
