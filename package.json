{
  "name": "somai.me",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "check-types": "turbo check-types",
    "ci:install": "pnpm install --frozen-lockfile",
    "dev": "turbo dev",
    "e2e": "turbo e2e",
    "fix": "ultracite fix",
    "prepare": "husky",
    "syncpack": "syncpack lint",
    "syncpack:fix": "syncpack fix && syncpack format",
    "test": "turbo test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "syncpack": "15.3.3",
    "turbo": "2.5.5",
    "typescript": "5.9.3",
    "ultracite": "7.0.12"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm exec ultracite fix"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "@types/node": "24.10.4"
    }
  }
}
